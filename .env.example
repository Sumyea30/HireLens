# Copy to .env (or backend/.env / frontend/.env) and fill in.
# Placeholder values only. Never commit a real .env.

# --- Backend (backend/app/core/config.py) ---
DATABASE_URL=postgresql://hirelens:change-me@localhost:5434/hirelens
REDIS_URL=redis://localhost:6379/0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

APPLY_EMAIL=applications@example.com
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

AUTH_SECRET=replace-with-a-long-random-string
TOKEN_TTL_MINUTES=480
USERS_JSON={}

CV_DIR=stored_cvs
PHOTO_DIR=stored_photos
FACE_PROVIDER=auto
FACE_MATCH_THRESHOLD=0.35
MAX_UPLOAD_MB=10

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
MAIL_POLL_INTERVAL_SECONDS=60

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

MCP_COMMAND=
MCP_ARGS=
MCP_URL=
MCP_ENV_KEYS=
MCP_CREATE_TOOL=create_post
MCP_CREATE_ARGS=
MCP_PUBLISH_TOOL=
MCP_PUBLISH_ARGS=
MCP_TIMEOUT_SECONDS=60

BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

LOG_DIR=logs
TRANSCRIPT_DIR=stored_transcripts

COPILOT_MAX_CALLS=15
COPILOT_INPUT_TOKENS=3000
COPILOT_OUTPUT_TOKENS=600
COPILOT_PER_MINUTE=5
COPILOT_DAILY_TOKENS=100000

EVAL_MAX_RUNS=2
EVAL_INPUT_TOKENS=12000
EVAL_OUTPUT_TOKENS=2000

# --- Frontend (Vite; see frontend/.env.example) ---
VITE_USE_MOCK=true
VITE_API_BASE=/api
VITE_WS_BASE=/ws
VITE_MAX_UPLOAD_MB=10
VITE_ICE_SERVERS=
