# Demo mode: runs fully in the browser with synthetic data and no backend.
# Set to "false" when the FastAPI backend is available.
VITE_USE_MOCK=true
# Base path of the REST API (Nginx proxies /api to FastAPI)
VITE_API_BASE=/api
# Base path of WebSockets (Nginx proxies /ws)
VITE_WS_BASE=/ws
# Maximum CV size in MB (the API enforces this too)
VITE_MAX_UPLOAD_MB=10
# Optional ICE servers as JSON. Needed when candidates join from other networks
# (STUN alone often fails behind strict NAT). Example including a free TURN:
# [{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:openrelay.metered.ca:80","username":"openrelayproject","credential":"openrelayproject"}]
# Leave empty for same-machine or same-network demos. See docs/tunnel.md.
# Document any STUN/TURN you add in the README's third-party disclosure (N18).
VITE_ICE_SERVERS=
# Optional: browser SpeechRecognition instead of server PCM STT (lower accuracy).
# Set backend STT_PROVIDER=browser as well. Default lang en-IN.
# VITE_STT_PROVIDER=browser
# VITE_BROWSER_STT_LANG=en-IN

