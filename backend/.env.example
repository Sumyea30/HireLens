# Copy to .env and fill in. Never commit .env.

# --- Postgres ---
POSTGRES_USER=hirelens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hirelens
DATABASE_URL=postgresql://hirelens:change-me@localhost:5434/hirelens

# --- Public origin (invite emails + ICS) ---
# Local: http://localhost:5173
# Remote via Cloudflare Tunnel: https://YOUR-SUBDOMAIN.trycloudflare.com
# See docs/tunnel.md
PUBLIC_BASE_URL=http://localhost:5173

# Comma-separated. Include localhost and your tunnel hostname when both are used.
CORS_ORIGINS=http://localhost:5173

# Sealed interview transcript JSON files (git-ignored). Empty = DB only.
TRANSCRIPT_DIR=stored_transcripts

# --- Speech-to-text (audio never written to local disk by default) ---
# Preferred for live captions: AssemblyAI cloud (set your key from https://www.assemblyai.com)
# Also: faster_whisper | fake | browser (browser = SpeechRecognition in Chrome; set VITE_STT_PROVIDER=browser)
STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
# BROWSER_STT_LANG=en-IN
# STT_DEBUG_DUMP=0
# STT_DEBUG_DUMP_DIR=stt_debug_dumps

# ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
# Batch upload is the reliable default (ASSEMBLYAI_LIVE=0). Streaming is optional.
# ASSEMBLYAI_SPEECH_MODEL=universal-streaming-english
# ASSEMBLYAI_LIVE=0
# STT_WORKERS=2
STT_TIMEOUT_SECONDS=90
STT_LANGUAGE=en
# STT_SILENCE_MS=900
# STT_MAX_UTTERANCE_S=12
# STT_SILENCE_RMS=180
# STT_MIN_SPEECH_S=0.6
# Optional self-hosted faster-whisper (compose profile "whisper"):
# STT_PROVIDER=faster_whisper
# STT_URL=http://127.0.0.1:8090
# STT_MODEL=small
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8
# STT_HIGH_NO_SPEECH=0.78
# STT_LOW_AVG_LOGPROB=-1.25
# STT_MIN_KEEP_CONFIDENCE=0.05

# --- Auth ---
AUTH_SECRET=replace-with-a-long-random-string
USERS_JSON=
TOKEN_TTL_MINUTES=480

# --- LLM ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

REDIS_URL=redis://localhost:6379/0

# --- Funnel Doctor (F11) ---
# FUNNEL_BOTTLENECK_MAX=0.2
# FUNNEL_FLAT_MIN=0.9
# FUNNEL_SHORTLIST_N=5
# FUNNEL_SUGGEST_MAX_PER_DAY=3
